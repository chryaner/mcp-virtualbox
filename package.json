{
  "name": "mcp-virtualbox",
  "version": "1.0.2",
  "description": "VirtualBox MCP server for Claude - vision-loop + text-based VM control",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-virtualbox": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test",
    "smoke": "node test/smoke.mjs",
    "e2e": "node test/e2e.mjs"
  },
  "keywords": [
    "mcp",
    "virtualbox",
    "vm",
    "model-context-protocol",
    "claude",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chryaner/mcp-virtualbox.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "ssh2": "^1.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.6",
    "typescript": "^5.8.2",
    "vitest": "^4.1.12"
  }
}
