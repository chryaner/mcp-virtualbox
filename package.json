{
  "name": "mcp-virtualbox",
  "version": "1.0.0",
  "description": "VirtualBox MCP server for Claude - vision-loop + text-based VM control",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "mcp-virtualbox": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "mcp",
    "virtualbox",
    "vm",
    "model-context-protocol",
    "claude",
    "ai",
    "automation"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chryaner/mcp-virtualbox.git"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "ssh2": "^1.16.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/ssh2": "^1.15.4",
    "typescript": "^5.8.2",
    "vitest": "^4.0.18"
  }
}
