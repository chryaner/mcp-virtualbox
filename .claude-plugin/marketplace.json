{
  "name": "mcp-virtualbox",
  "owner": {
    "name": "Eiliya Raizis"
  },
  "metadata": {
    "description": "Let AI see, click, type, and fully operate virtual machines"
  },
  "plugins": [
    {
      "name": "mcp-virtualbox",
      "description": "VirtualBox MCP server - 30 tools for full VM control via vision loop and text mode",
      "version": "1.0.0",
      "homepage": "https://github.com/chryaner/mcp-virtualbox",
      "repository": "https://github.com/chryaner/mcp-virtualbox",
      "license": "MIT",
      "keywords": ["virtualbox", "vm", "mcp", "automation"],
      "source": {
        "source": "npm",
        "package": "mcp-virtualbox"
      },
      "mcpServers": {
        "mcp-virtualbox": {
          "command": "npx",
          "args": ["-y", "mcp-virtualbox"]
        }
      }
    }
  ]
}
